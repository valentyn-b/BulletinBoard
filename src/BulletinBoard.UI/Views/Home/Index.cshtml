@{
    ViewData["Title"] = "Головна";
}

<div class="container mt-5 text-center">
    <h2 class="fw-bold mb-5" style="color: #002f34;">Розділи на сервісі BulletinBoard</h2>
    
    <div class="row justify-content-center g-4">
        <div class="col-6 col-md-3 col-lg-2">
            <a asp-controller="Announcements" asp-action="Index" asp-route-category="1" class="category-link d-block">
                <div class="category-circle mx-auto mb-3 d-flex align-items-center justify-content-center rounded-circle">
                    <i class="bi bi-house-gear fs-1" style="color: #002f34;"></i>
                </div>
                <span class="fw-semibold">Побутова техніка</span>
            </a>
        </div>

        <div class="col-6 col-md-3 col-lg-2">
            <a asp-controller="Announcements" asp-action="Index" asp-route-category="2" class="category-link d-block">
                <div class="category-circle mx-auto mb-3 d-flex align-items-center justify-content-center rounded-circle">
                    <i class="bi bi-pc-display fs-1" style="color: #002f34;"></i>
                </div>
                <span class="fw-semibold">Комп'ютери</span>
            </a>
        </div>

        <div class="col-6 col-md-3 col-lg-2">
            <a asp-controller="Announcements" asp-action="Index" asp-route-category="3" class="category-link d-block">
                <div class="category-circle mx-auto mb-3 d-flex align-items-center justify-content-center rounded-circle">
                    <i class="bi bi-phone fs-1" style="color: #002f34;"></i>
                </div>
                <span class="fw-semibold">Смартфони</span>
            </a>
        </div>

        <div class="col-6 col-md-3 col-lg-2">
            <a asp-controller="Announcements" asp-action="Index" asp-route-category="4" class="category-link d-block">
                <div class="category-circle mx-auto mb-3 d-flex align-items-center justify-content-center rounded-circle">
                    <i class="bi bi-box-seam fs-1" style="color: #002f34;"></i>
                </div>
                <span class="fw-semibold">Інше</span>
            </a>
        </div>
    </div>
</div>