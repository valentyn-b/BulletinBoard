@model IEnumerable<BulletinBoard.UI.Models.Dtos.AnnouncementDto>

@{
    ViewData["Title"] = "Дошка оголошень";
}

<div class="container mt-4">
    <div class="d-flex justify-content-between align-items-center mb-4">
        <h2 class="fw-bold">Останні оголошення</h2>
        <a href="#" class="btn btn-primary rounded-pill px-4 shadow-sm">
            <i class="bi bi-plus-lg"></i> + Створити
        </a>
    </div>

    @if (!Model.Any())
    {
        <div class="alert alert-light text-center p-5 shadow-sm rounded-4" role="alert">
            <h4 class="alert-heading text-muted mb-3">Оголошень поки немає 😢</h4>
            <p class="mb-0">Будьте першим, хто додасть нове оголошення на нашу дошку!</p>
        </div>
    }
    else
    {
        <div class="row row-cols-1 row-cols-md-2 row-cols-lg-3 g-4">
            @foreach (var item in Model)
            {
                <div class="col">
                    <div class="card h-100 border-0 shadow-sm rounded-4 transition-hover">
                        <div class="card-body p-4">
                            <div class="d-flex justify-content-between mb-2">
                                <span class="badge bg-primary bg-opacity-10 text-primary rounded-pill px-3 py-2">
                                    @item.Category
                                </span>
                                <span class="text-muted small">
                                    @item.CreatedDate.ToString("dd MMM yyyy")
                                </span>
                            </div>
                            
                            <h5 class="card-title fw-bold mt-3 mb-2 text-truncate" title="@item.Title">
                                @item.Title
                            </h5>
                            
                            <p class="card-text text-muted" style="display: -webkit-box; -webkit-line-clamp: 3; -webkit-box-orient: vertical; overflow: hidden;">
                                @item.Description
                            </p>
                        </div>
                        <div class="card-footer bg-transparent border-0 p-4 pt-0 d-flex justify-content-between align-items-center">
                            <span class="badge bg-light text-dark border">
                                @item.SubCategory
                            </span>
                            
                            <div class="btn-group">
                                <a href="#" class="btn btn-sm btn-outline-secondary">Деталі</a>
                            </div>
                        </div>
                    </div>
                </div>
            }
        </div>
    }
</div>