@model BulletinBoard.UI.Models.AnnouncementViewModel

@{
    ViewData["Title"] = "Видалення оголошення";
}

<div class="container mt-5 flex-grow-1" style="max-width: 600px;">
    <div class="card border-danger shadow-sm rounded-4 overflow-hidden hover-elevate">
        <div class="card-header bg-danger text-white p-4 text-center">
            <i class="bi bi-exclamation-triangle display-4"></i>
            <h2 class="fw-bold mt-2 mb-0">Ви впевнені?</h2>
        </div>
        
        <div class="card-body p-4 p-md-5 text-center">
            <h5 class="text-muted mb-4">Ви збираєтесь назавжди видалити це оголошення:</h5>
            <div class="p-4 bg-light rounded-4 mb-4 text-start border border-danger border-opacity-25 shadow-sm">
                <h4 class="fw-bold mb-3 text-brand-dark">@Model.Title</h4>
                <div class="d-flex flex-wrap align-items-center gap-2 mb-0">
                    <span class="badge bg-primary bg-opacity-10 text-primary rounded-pill px-3 py-2">
                        @Model.Category.GetDisplayName()
                    </span>
                    <span class="badge bg-light text-dark border px-3 py-2">
                        @Model.SubCategory.GetDisplayName()
                    </span>
                    <small class="text-muted ms-auto">
                        <i class="bi bi-calendar-event"></i> @Model.CreatedDate.ToString("dd MMM yyyy")
                    </small>
                </div>
            </div>
            <p class="text-danger fw-semibold mb-0">Цю дію неможливо буде скасувати!</p>
        </div>

        <div class="card-footer bg-white border-top-0 p-4 d-flex justify-content-center gap-3">
            <a asp-action="Details" asp-route-id="@Model.Id" class="btn btn-outline-secondary rounded-pill px-4 hover-elevate">
                Скасувати
            </a>
            
            <form asp-action="Delete" asp-route-id="@Model.Id" method="post">
                <button type="submit" class="btn btn-danger rounded-pill px-5 shadow-sm hover-elevate">
                    Так, видалити
                </button>
            </form>
        </div>
    </div>
</div>