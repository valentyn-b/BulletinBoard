@model BulletinBoard.UI.Models.UpdateAnnouncementViewModel

@{
    ViewData["Title"] = "Редагування оголошення";
}

<div class="container mt-4 flex-grow-1" style="max-width: 800px;">
    <div class="mb-4 d-flex justify-content-between align-items-center">
        <a asp-action="Details" asp-route-id="@Model.Id" class="btn btn-light rounded-pill shadow-sm px-3 hover-elevate d-flex align-items-center">
            <i class="bi bi-arrow-left me-2"></i> Скасувати
        </a>
        <h2 class="fw-bold mb-0 text-brand-dark">Редагування</h2>
    </div>

    <div class="card border-0 shadow-sm rounded-4 overflow-hidden">
        <div class="card-body p-4 p-md-5">
            <form asp-action="Edit" method="post">
                <div asp-validation-summary="ModelOnly" class="text-danger mb-3"></div>
                <input type="hidden" asp-for="Id" />

                <div class="mb-4">
                    <label asp-for="Title" class="form-label fw-semibold text-brand-dark">Назва оголошення <span class="text-danger">*</span></label>
                    <input asp-for="Title" class="form-control form-control-lg border-0 shadow-sm rounded-3" placeholder="Наприклад: Продам MacBook Pro 16" />
                    <span asp-validation-for="Title" class="text-danger small"></span>
                </div>

                <div class="mb-4">
                    <partial name="_CategoryDropdowns" model="@((Category?)Model.Category, (SubCategory?)Model.SubCategory, true)" />
                </div>

                <div class="mb-4">
                    <label asp-for="Description" class="form-label fw-semibold text-brand-dark">Опис <span class="text-danger">*</span></label>
                    <textarea asp-for="Description" class="form-control border-0 shadow-sm rounded-3" rows="6" placeholder="Детально опишіть ваш товар чи послугу..."></textarea>
                    <span asp-validation-for="Description" class="text-danger small"></span>
                </div>

                <div class="mb-5 p-4 bg-light rounded-4 shadow-sm">
                    <div class="form-check form-switch fs-5 mb-0">
                        <input class="form-check-input" type="checkbox" role="switch" asp-for="Status">
                            <label class="form-check-label fw-bold text-brand-dark ms-2" asp-for="Status">
                                Оголошення активне
                            </label>
                        </div>
                        <div class="form-text mt-2">
                            <i class="bi bi-info-circle me-1"></i> Якщо вимкнути, оголошення не буде видалене, але зникне із загального пошуку.
                        </div>
                    </div>

                    <div class="d-grid">
                        <button type="submit" class="btn btn-primary btn-lg rounded-pill shadow-sm bg-brand-dark border-0 hover-elevate">
                            <i class="bi bi-check2-circle me-2"></i> Зберегти зміни
                        </button>
                    </div>
                </form>
            </div>
        </div>
    </div>

    @section Scripts {
        @{
            await Html.RenderPartialAsync("_ValidationScriptsPartial");
        }
        <script>
            if (typeof initCategoryCascade === "function") {
                initCategoryCascade('categorySelect', 'subCategorySelect');
            }
        </script>
    }