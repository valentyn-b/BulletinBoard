@model IEnumerable<BulletinBoard.UI.Models.AnnouncementViewModel>

@{
    ViewData["Title"] = "Переглянути оголошення";
}

<div class="container mt-4">
    <div class="d-flex justify-content-between align-items-center mb-4">
        <h2 class="fw-bold">Переглянути оголошення</h2>
    </div>

    <div class="card border-0 shadow-sm rounded-4 mb-4 bg-light">
        <div class="card-body p-4">
            <form asp-controller="Announcements" asp-action="Index" method="get" class="row g-3 align-items-end">
                
                <div class="col-md-8">
                    <partial name="_CategoryDropdowns" model="@(ViewBag.CurrentCategory as Category?, ViewBag.CurrentSubCategory as SubCategory?, false)" />
                </div>
                <div class="col-md-4 d-flex gap-2">
                    <button type="submit" class="btn btn-primary bg-brand-dark border-0 rounded-pill px-4 hover-elevate shadow-sm">
                        <i class="bi bi-search me-1"></i> Знайти
                    </button>
                    <a asp-controller="Announcements" asp-action="Index" class="btn btn-outline-secondary rounded-pill shadow-sm px-4">
                        Скинути
                    </a>
                </div>
            </form>
        </div>
    </div>

    @if (!Model.Any())
    {
        <div class="alert alert-light text-center p-5 shadow-sm rounded-4" role="alert">
            <h4 class="alert-heading text-muted mb-3">Оголошень поки немає 😢</h4>
            <p class="mb-0">За вашим запитом нічого не знайдено, або дошка ще порожня.</p>
        </div>
    }
    else
    {
        <div class="row row-cols-1 row-cols-md-2 row-cols-lg-3 g-4">
            @foreach (var item in Model)
            {
                <div class="col">
                    <div class="card h-100 border-0 shadow-sm rounded-4 transition-hover">
                        <div class="card-body p-4">
                            <div class="d-flex justify-content-between mb-2">
                                <span class="badge bg-primary bg-opacity-10 text-primary rounded-pill px-3 py-2">
                                    @item.Category.GetDisplayName()
                                </span>
                                <span class="text-muted small">
                                    @item.CreatedDate.ToString("dd MMM yyyy")
                                </span>
                            </div>
                            <h5 class="card-title fw-bold mt-3 mb-2 text-truncate" title="@item.Title">
                                @item.Title
                            </h5>
                            <p class="card-text text-muted" style="display: -webkit-box; -webkit-line-clamp: 3; -webkit-box-orient: vertical; overflow: hidden;">
                                @item.Description
                            </p>
                        </div>
                        <div class="card-footer bg-transparent border-0 p-4 pt-0 d-flex justify-content-between align-items-center">
                            <span class="badge bg-light text-dark border">@item.SubCategory.GetDisplayName()</span>
                            <div class="btn-group">
                                <a asp-controller="Announcements" asp-action="Details" asp-route-id="@item.Id" class="btn btn-sm btn-outline-secondary">Деталі</a>
                            </div>
                        </div>
                    </div>
                </div>
            }
        </div>
    }
</div>

@section Scripts {
    <script>
        if (typeof initCategoryCascade === "function") {
            initCategoryCascade('categorySelect', 'subCategorySelect');
        }
    </script>
}