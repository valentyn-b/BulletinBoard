@using BulletinBoard.UI.Models.Enums
@model IEnumerable<BulletinBoard.UI.Models.Dtos.AnnouncementDto>

@{
    ViewData["Title"] = "Всі оголошення";
}

<div class="container mt-4">
    <div class="d-flex justify-content-between align-items-center mb-4">
        <h2 class="fw-bold">Всі оголошення</h2>
        <a asp-controller="Announcements" asp-action="Create" class="btn btn-primary rounded-pill px-4 shadow-sm">
            <i class="bi bi-plus-lg"></i> Створити
        </a>
    </div>

    <div class="card border-0 shadow-sm rounded-4 mb-4 bg-light">
        <div class="card-body p-4">
            <form asp-controller="Announcements" asp-action="Index" method="get" class="row g-3 align-items-end">
                <div class="col-md-4">
                    <label for="category" class="form-label fw-semibold text-muted small mb-1">Категорія</label>
                    <select name="category" id="category" class="form-select border-0 shadow-sm" asp-items="Html.GetEnumSelectList<Category>()">
                        <option value="">Всі категорії</option>
                    </select>
                </div>
                
                <div class="col-md-4">
                    <label for="subCategory" class="form-label fw-semibold text-muted small mb-1">Підкатегорія</label>
                    <select name="subCategory" id="subCategory" class="form-select border-0 shadow-sm" asp-items="Html.GetEnumSelectList<SubCategory>()">
                        <option value="">Всі підкатегорії</option>
                    </select>
                </div>
                
                <div class="col-md-4 d-flex gap-2">
                    <button type="submit" class="btn btn-primary shadow-sm px-4 flex-grow-1">
                        <i class="bi bi-search me-1"></i> Знайти
                    </button>
                    <a asp-controller="Announcements" asp-action="Index" class="btn btn-outline-secondary shadow-sm">
                        Скинути
                    </a>
                </div>
            </form>
        </div>
    </div>

    @if (!Model.Any())
    {
        <div class="alert alert-light text-center p-5 shadow-sm rounded-4" role="alert">
            <h4 class="alert-heading text-muted mb-3">Оголошень поки немає 😢</h4>
            <p class="mb-0">За вашим запитом нічого не знайдено, або дошка ще порожня.</p>
        </div>
    }
    else
    {
        <div class="row row-cols-1 row-cols-md-2 row-cols-lg-3 g-4">
            @foreach (var item in Model)
            {
                <div class="col">
                    <div class="card h-100 border-0 shadow-sm rounded-4 transition-hover">
                        <div class="card-body p-4">
                            <div class="d-flex justify-content-between mb-2">
                                <span class="badge bg-primary bg-opacity-10 text-primary rounded-pill px-3 py-2">
                                    @item.Category
                                </span>
                                <span class="text-muted small">
                                    @item.CreatedDate.ToString("dd MMM yyyy")
                                </span>
                            </div>
                            <h5 class="card-title fw-bold mt-3 mb-2 text-truncate" title="@item.Title">
                                @item.Title
                            </h5>
                            <p class="card-text text-muted" style="display: -webkit-box; -webkit-line-clamp: 3; -webkit-box-orient: vertical; overflow: hidden;">
                                @item.Description
                            </p>
                        </div>
                        <div class="card-footer bg-transparent border-0 p-4 pt-0 d-flex justify-content-between align-items-center">
                            <span class="badge bg-light text-dark border">@item.SubCategory</span>
                            <div class="btn-group">
                                <a asp-controller="Announcements" asp-action="Details" asp-route-id="@item.Id" class="btn btn-sm btn-outline-secondary">Деталі</a>
                            </div>
                        </div>
                    </div>
                </div>
            }
        </div>
    }
</div>

@section Scripts {
    <script>
        var currentCat = '@((int?)ViewBag.CurrentCategory)';

        var currentSubCat = '@((int?)ViewBag.CurrentSubCategory)';

        if (currentCat) document.getElementById('category').value = currentCat;

        if (currentSubCat) document.getElementById('subCategory').value = currentSubCat;

        const rules = @Html.Raw(ViewBag.CategoryRules);

        initCategoryCascade('category', 'subCategory', rules);
    </script>
}