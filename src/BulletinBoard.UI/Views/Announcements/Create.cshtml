@model BulletinBoard.UI.Models.CreateAnnouncementViewModel

@{
    ViewData["Title"] = "Створити оголошення";
}

<div class="container mt-4 flex-grow-1" style="max-width: 700px;">
    <div class="d-flex align-items-center mb-4">
        <a asp-controller="Announcements" asp-action="Index" class="btn btn-light rounded-circle me-3 shadow-sm d-flex justify-content-center align-items-center hover-elevate" style="width: 40px; height: 40px;">
            <i class="bi bi-arrow-left"></i>
        </a>
        <h2 class="fw-bold mb-0 text-brand-dark">Нове оголошення</h2>
    </div>

    <div class="card border-0 shadow-sm rounded-4 p-4 p-md-5">
        <form asp-controller="Announcements" asp-action="Create" method="post">
            <div asp-validation-summary="ModelOnly" class="text-danger mb-3"></div>

            <div class="mb-4">
                <label asp-for="Title" class="form-label fw-semibold text-brand-dark">Заголовок</label>
                <input asp-for="Title" class="form-control form-control-lg border-0 shadow-sm rounded-3" placeholder="Наприклад: Продам ноутбук" />
                <span asp-validation-for="Title" class="text-danger small"></span>
            </div>

            <div class="mb-4">
                <label asp-for="Description" class="form-label fw-semibold text-brand-dark">Опис</label>
                <textarea asp-for="Description" class="form-control border-0 shadow-sm rounded-3" rows="5" placeholder="Детально опишіть ваш товар..."></textarea>
                <span asp-validation-for="Description" class="text-danger small"></span>
            </div>

            <div class="mb-4">
                <partial name="_CategoryDropdowns" model="@(Model?.Category, Model?.SubCategory, true)" />
            </div>

            <hr class="my-4 text-muted">

            <div class="d-grid gap-2 d-md-flex justify-content-md-end">
                <a asp-controller="Announcements" asp-action="Index" class="btn btn-outline-secondary rounded-pill px-4">Скасувати</a>
                <button type="submit" class="btn btn-primary bg-brand-dark border-0 rounded-pill px-5 hover-elevate shadow-sm">Опублікувати</button>
            </div>
        </form>
    </div>
</div>

@section Scripts {
    @{
        await Html.RenderPartialAsync("_ValidationScriptsPartial");
    }
    <script>
        if (typeof initCategoryCascade === "function") {
            initCategoryCascade('categorySelect', 'subCategorySelect');
        }
    </script>
}