@model IEnumerable<BulletinBoard.UI.Models.AnnouncementViewModel>

@{
    ViewData["Title"] = "Мої оголошення";
}

<div class="d-flex justify-content-between align-items-center mb-4">
    <h2 class="fw-bold">Мої оголошення</h2>
    <a asp-action="Create" class="btn btn-success rounded-pill px-4">
        <i class="bi bi-plus-circle"></i> Створити
    </a>
</div>

<div class="row row-cols-1 row-cols-md-2 row-cols-lg-3 g-4">
    @foreach (var item in Model)
    {
        <div class="col">
            <partial name="_AnnouncementCard" model="item" view-data='new ViewDataDictionary(ViewData) { { "ShowActions", true } }' />
        </div>
    }
</div>

@if (!Model.Any())
{
    <div class="text-center mt-5">
        <i class="bi bi-inbox text-muted" style="font-size: 4rem;"></i>
        <h4 class="mt-3 text-muted">У вас ще немає оголошень</h4>
        <p>Створіть своє перше оголошення прямо зараз!</p>
    </div>
}