@model BulletinBoard.UI.Models.AnnouncementViewModel

@{
    ViewData["Title"] = Model.Title;
}

<div class="container mt-4 flex-grow-1" style="max-width: 800px;">
    <div class="mb-4">
        <a asp-controller="Announcements" asp-action="Index" class="btn btn-light rounded-pill shadow-sm px-3 hover-elevate d-inline-flex align-items-center text-muted">
            <i class="bi bi-arrow-left me-2"></i> Повернутися до всіх оголошень
        </a>
    </div>

    <div class="card border-0 shadow-sm rounded-4 overflow-hidden">
        <div class="card-header bg-white border-bottom-0 pt-4 pb-0 px-4 px-md-5 d-flex flex-wrap justify-content-between align-items-center gap-3">
            <div>
                <span class="badge bg-primary bg-opacity-10 text-primary rounded-pill px-3 py-2 me-2 mb-2 mb-md-0">
                    @Model.Category.GetDisplayName()
                </span>
                <span class="badge bg-light text-dark border rounded-pill px-3 py-2">
                    @Model.SubCategory.GetDisplayName()
                </span>
            </div>
            <span class="text-muted small">
                <i class="bi bi-calendar3"></i> Опубліковано: @Model.CreatedDate.ToString("dd MMMM yyyy, HH:mm")
            </span>
        </div>

        <div class="card-body p-4 p-md-5">
            <h1 class="card-title fw-bold mb-4 text-brand-dark">@Model.Title</h1>
            
            <h5 class="fw-semibold text-muted mb-3 border-bottom pb-2">Опис</h5>
            <div class="card-text fs-5 text-dark" style="white-space: pre-wrap; line-height: 1.6;">@Model.Description</div>
        </div>

        <div class="card-footer bg-light border-top p-4 d-flex justify-content-between align-items-center">
            <div>
                <span class="badge @(Model.Status ? "bg-success" : "bg-secondary") bg-opacity-10 @(Model.Status ? "text-success" : "text-secondary") rounded-pill px-3 py-2">
                    <i class="bi @(Model.Status ? "bi-check-circle" : "bi-dash-circle") me-1"></i> Статус: @(Model.Status ? "Активне" : "Неактивне")
                </span>
            </div>
        </div>
    </div>
</div>